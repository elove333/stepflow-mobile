# Live Agent API key. Keep it private.
SOPO_API_KEY=sopo-your-live-agent-key-here

# Production SOPO origin.
SOPO_ORIGIN=https://sopolabs.ai

# Optional runner display name.
AGENT_NAME=stepflow-sopo-live-agent

# Local guard below the server turn timer.
DECISION_TIMEOUT_MS=7500

# Path to the JSONL hand-history memory file (relative to cwd, or absolute).
# Defaults to bot-memory.jsonl in the directory where npm start is run.
BOT_MEMORY_PATH=bot-memory.jsonl

